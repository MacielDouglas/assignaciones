generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum InviteTokenType {
  ORGANIZATION_CREATE
  MEMBER_INVITE
}

enum Sex {
  MALE
  FEMALE
}

enum MeetingType {
  MIDWEEK
  WEEKEND
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SpecialEventKind {
  MEMORIAL
  SPECIAL_TALK
  CIRCUIT_OVERSEER_VISIT
  CONVENTION
  ASSEMBLY_TRAVELING_OVERSEER
  ASSEMBLY_REPRESENTATIVE
}

enum AllowedSex {
  MALE
  FEMALE
  BOTH
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions       Session[]
  accounts       Account[]
  memberships    OrganizationMember[]
  createdTokens  InviteToken[] @relation("InviteTokenCreatedBy")
  redeemedTokens InviteToken[] @relation("InviteTokenUsedBy")
}

model Organization {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          OrganizationMember[]
  families         Family[]
  persons          Person[]
  meetingWorkbooks MeetingWorkbook[]
  watchtowers      Watchtower[]
  songs            Song[]
  talks            Talk[]
  inviteTokens     InviteToken[]
  meetingSchedule  MeetingSchedule?
  scheduledMeetings ScheduledMeeting[]
  specialEvents    SpecialEvent[]
  cleaningSectors       CleaningSector[]
  cleaningWeekly        CleaningWeekly?
  cleaningWeeklyDates   CleaningWeeklyDate[]
  cleaningWeeklySectors CleaningWeeklySector[]
  cleaningGeneral       CleaningGeneral[]
  cleaningGeneralSectors CleaningGeneralSector[]
}

model OrganizationMember {
  id             String     @id @default(cuid())
  organizationId String
  userId         String     @unique
  role           MemberRole @default(MEMBER)
  personId       String?    @unique
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  person       Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model Family {
  id             String   @id @default(cuid())
  name           String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  persons       Person[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model MeetingWorkbook {
  id             String      @id @default(cuid())
  organizationId String
  meetingType    MeetingType @default(MIDWEEK)
  symbol         String
  name           String
  shortTitle     String?
  displayTitle   String?
  referenceTitle String?
  languageCode   String?
  fileName       String?
  coverImageUrl  String?
  content        Json
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, meetingType, symbol])
  @@index([organizationId, meetingType])
}

model MeetingSchedule {
  id             String   @id @default(cuid())
  organizationId String   @unique
  midweekDay     WeekDay?
  midweekTime    String?
  weekendDay     WeekDay?
  weekendTime    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model SpecialEvent {
  id             String            @id @default(cuid())
  organizationId String
  kind           SpecialEventKind
  date           DateTime
  endDate        DateTime?
  time           String?
  location       String?
  theme          String?
  speaker        String?
  traveler       String?
  serviceTalk    String?
  publicTalk     String?
  finalTalk      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind])
  @@index([organizationId, date])
}

model CleaningSector {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  task           String     @default("")
  peopleNeeded   Int
  allowsYouth    Boolean    @default(true)
  allowedSex     AllowedSex @default(BOTH)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model CleaningWeeklySector {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  task           String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model CleaningGeneralSector {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  task           String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model CleaningWeekly {
  id             String   @id @default(cuid())
  organizationId String   @unique
  time           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model CleaningWeeklyDate {
  id             String   @id @default(cuid())
  organizationId String
  date           DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@index([organizationId])
}

model CleaningGeneral {
  id             String   @id @default(cuid())
  organizationId String
  date           DateTime
  time           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
}

model Watchtower {
  id             String   @id @default(cuid())
  organizationId String
  symbol         String
  name           String
  languageCode   String?
  fileName       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  articles     WatchtowerArticle[]

  @@unique([organizationId, symbol])
  @@index([organizationId])
}

model WatchtowerArticle {
  id           String @id @default(cuid())
  watchtowerId String
  title        String
  dates        String?
  color        String?
  openingSong  Int?
  closingSong  Int?
  order        Int    @default(0)

  watchtower       Watchtower        @relation(fields: [watchtowerId], references: [id], onDelete: Cascade)
  scheduledMeetings ScheduledMeeting[]

  @@index([watchtowerId])
}

model Song {
  id             String   @id @default(cuid())
  organizationId String
  number         Int
  theme          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, number])
  @@index([organizationId])
}

model Talk {
  id             String   @id @default(cuid())
  organizationId String
  number         Int
  theme          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, number])
  @@index([organizationId])
}

model Person {
  id             String   @id @default(cuid())
  nome           String
  sexo           Sex      @default(MALE)
  chefeFamilia   Boolean  @default(false)
  familiaId      String
  organizationId String
  jovem          Boolean  @default(false)
  estudante      Boolean  @default(true)
  batizado       Boolean  @default(false)
  ativo          Boolean  @default(true)
  limpeza        Boolean  @default(true)
  casado         Boolean  @default(false)
  spouseId       String?  @unique
  // Data da designação mais recente (denormalizada, mantida pelo serviço de programação)
  lastAssignmentDate DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Condicionais de estudante (apenas quando estudante = true)
  iniciandoConversa    Boolean @default(false)
  cultivandoInteresse  Boolean @default(false)
  fazendoDiscipulos    Boolean @default(false)
  explicandoCrencas    Boolean @default(false)

  // Condicionais: sexo M + estudante (apenas quando ativos)
  discursoFacaseuMelhor Boolean @default(false)
  leituraBiblia         Boolean @default(true)

  // Condicionais: sexo M + batizado
  privilegiosServico Boolean @default(false)
  oracao             Boolean @default(false)

  // Condicionais: sexo M + batizado + privilégios de serviço
  anciao                     Boolean @default(false)
  oQueVoceDiria              Boolean @default(false)
  presidenteNossaVida        Boolean @default(false)
  discursoTesouros           Boolean @default(false)
  joiasEspirituais           Boolean @default(false)
  partesNossaVidaCrista      Boolean @default(false)
  estudoBiblicoCongregacao   Boolean @default(false)
  leitorEstudoBiblico        Boolean @default(false)
  presidenteReuniaoPublica   Boolean @default(false)
  discursoPublico            Boolean @default(false)
  dirigenteEstudoSentinela   Boolean @default(false)
  leitorEstudoSentinela      Boolean @default(false)

  // Publicador externo (ex.: superintendente de circuito/viajante):
  // aparece apenas nas partes da visita, fora das demais listas.
  visitante                  Boolean @default(false)

  familia Family           @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  spouse  Person?          @relation("Marriage", fields: [spouseId], references: [id], onDelete: SetNull)
  marriedTo Person?        @relation("Marriage")
  member  OrganizationMember?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviteToken InviteToken?
  scheduledAssignments ScheduledAssignment[]

  @@index([familiaId])
  @@index([organizationId])
}

model InviteToken {
  id             String          @id @default(cuid())
  codeHash       String          @unique
  type           InviteTokenType
  organizationId String?
  createdById    String
  personId       String?          @unique
  usedById       String?
  usedAt         DateTime?
  expiresAt      DateTime
  createdAt      DateTime        @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("InviteTokenCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy       User?         @relation("InviteTokenUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  person       Person?       @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

model Account {
  id           String    @id @default(cuid())
  accountId    String
  providerId   String
  issuer       String    @default("")
  userId       String
  accessToken  String?
  refreshToken String?
  idToken      String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope        String?
  password     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ScheduledMeeting {
  id             String      @id @default(cuid())
  organizationId String
  weekStart      DateTime
  meetingType    MeetingType @default(MIDWEEK)
  middleSong     Int?
  openingSong    Int?
  closingSong    Int?
  talkNumber     Int?
  articleId      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  article      WatchtowerArticle?    @relation(fields: [articleId], references: [id], onDelete: SetNull)
  assignments  ScheduledAssignment[]

  @@unique([organizationId, weekStart, meetingType])
  @@index([organizationId])
}

model ScheduledAssignment {
  id                 String   @id @default(cuid())
  scheduledMeetingId String
  partId             String
  label              String
  personId           String
  createdAt          DateTime @default(now())

  scheduledMeeting ScheduledMeeting @relation(fields: [scheduledMeetingId], references: [id], onDelete: Cascade)
  person           Person           @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([scheduledMeetingId, partId])
  @@index([personId])
}