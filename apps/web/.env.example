# Banco de dados (Neon Postgres)
# Crie um projeto em https://console.neon.tech e copie a connection string
# Exemplo: postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth - chave secreta (gere com: openssl rand -base64 32)
BETTER_AUTH_SECRET="gerar-chave-secreta-aqui"

# URL base do app em desenvolvimento
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="seu-google-client-id"
GOOGLE_CLIENT_SECRET="seu-google-client-secret"

# Apple Sign In (https://developer.apple.com/account/resources/authkeys)
APPLE_CLIENT_ID="com.seu.app.asignaciones"
APPLE_CLIENT_SECRET="seu-apple-client-secret"

# E-mail do sub-user (super-user). Quem fizer login com este e-mail
# tem acesso total a todas as organizações e gerencia os tokens globais.
SUPER_USER_EMAIL="super.user@exemplo.com"