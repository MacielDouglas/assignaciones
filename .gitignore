# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# prisma generated client
/src/generated/

# database
*.db
*.sqlite

# agentes locais (config e skills do agente, não fazem parte do produto)
.opencode/

# impeccable — estado de execução do live mode (config e design ficam rastreados)
.impeccable/live/annotations/
.impeccable/live/sessions/
.impeccable/live/inject-journal.json
.impeccable/live/roots.json
.impeccable/live/server.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
