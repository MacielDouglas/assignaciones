# Banco de dados PostgreSQL (ex.: Neon)
# Exemplo: postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/db"

# Better Auth - chave secreta (gere com: openssl rand -base64 32)
BETTER_AUTH_SECRET="gerar-chave-secreta-aqui"

# URL base do app
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="seu-google-client-id"
GOOGLE_CLIENT_SECRET="seu-google-client-secret"

# Sub-user: emails (separados por vírgula) com acesso total irrestrito
SUB_USER_EMAILS="email-do-subuser@gmail.com"
